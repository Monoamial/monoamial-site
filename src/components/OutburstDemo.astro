<figure class="outburst-demo">
  <iframe
    id="lattice-outburst-demo"
    src="/simulations/lattice-outburst/index.html"
    title="Interactive lattice outburst process: step through random diamond-shaped infections"
    loading="lazy"
    sandbox="allow-scripts allow-same-origin"
  ></iframe>
  <figcaption>
    A two-dimensional lattice outburst process. The display highlights the latest
    outburst's centre, radius, and newly infected sites.
    <a href="/simulations/lattice-outburst/index.html" target="_blank" rel="noopener">Open the simulation on its own ↗</a>
  </figcaption>
</figure>
<style>
  .outburst-demo { margin: 2rem 0; }
  iframe { display: block; width: 100%; height: 820px; border: 1px solid var(--board-edge, #43534d); border-radius: 10px; background: #17221f; }
  figcaption { margin-top: .8rem; color: var(--chalk-dim); font-size: .92rem; line-height: 1.6; }
  figcaption a { display: block; margin-top: .3rem; }
  @media (max-width: 600px) { iframe { height: 820px; } }
</style>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('#lattice-outburst-demo');
  window.addEventListener('message', (event) => {
    if (!frame || event.origin !== window.location.origin || event.source !== frame.contentWindow) return;
    if (event.data?.type !== 'lattice-outburst-resize' || !Number.isFinite(event.data.height)) return;
    frame.style.height = `${Math.max(300, Math.min(1600, event.data.height + 2))}px`;
  });
</script>
