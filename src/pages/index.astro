---
import Base from '../layouts/Base.astro';
import PhaseField from '../components/PhaseField.astro';

const pillars = [
  {
    href: '/research/',
    kicker: '01',
    title: 'Research',
    description: 'Probability and statistical mechanics, from growing clusters to phase transitions in the Ising model.',
    accent: 'var(--accent)',
  },
  {
    href: '/code/',
    kicker: '02',
    title: 'Code & Simulation',
    description: 'Interactive models and numerical experiments that explore how simple rules produce collective behavior.',
    accent: 'var(--accent-2)',
  },
  {
    href: '/writing/',
    kicker: '03',
    title: 'Writing',
    description: 'Expository notes and essays on mathematics and physics.',
    accent: 'var(--accent-3)',
  },
  {
    href: '/teaching/',
    kicker: '04',
    title: 'Teaching',
    description: 'Mentoring students as they develop long-term projects around their own interests.',
    accent: 'var(--accent-4)',
  },
];
---
<Base title={null}>
  <section class="hero">
    <div class="board-frame">
      <PhaseField />
      <div class="hero-text">
        <p class="eyebrow">Master&rsquo;s student · Technical University of Munich</p>
        <h1>Noam <span class="chalk-underline">Borgnia</span></h1>
        <p class="lede">
          I&rsquo;m interested in <strong>how local interactions become collective laws</strong>,
          when simpler equations capture them, and how computational complexity shapes
          what we can hope to predict.
        </p>
      </div>
    </div>
  </section>

  <section class="pillars">
    {pillars.map((p) => (
      <a href={p.href} class="note-card pillar" style={`--c:${p.accent}`}>
        <span class="kicker">{p.kicker}</span>
        <h2>{p.title}</h2>
        <p>{p.description}</p>
        <span class="go">open &rarr;</span>
      </a>
    ))}
  </section>
</Base>

<style>
  .hero { margin: 1.8rem 0 2.5rem; }
  .board-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 10px solid;
    border-image: linear-gradient(135deg, var(--wood), var(--wood-2)) 1;
    box-shadow: 0 18px 50px rgba(0,0,0,0.45), inset 0 0 60px rgba(0,0,0,0.35);
    min-height: 360px;
    display: flex;
    align-items: center;
  }
  .hero-text {
    position: relative;
    z-index: 2;
    padding: 2.5rem clamp(1.2rem, 4vw, 3rem);
    /* lets clicks/hover reach the canvas underneath everywhere except the text itself */
    pointer-events: none;
  }
  .hero-text a { pointer-events: auto; }
  .eyebrow {
    font-family: var(--font-label);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent-2);
    margin: 0 0 0.5rem;
  }
  .hero h1 { font-size: clamp(3rem, 9vw, 5.5rem); margin: 0; }
  .lede { font-size: clamp(1.1rem, 2.4vw, 1.45rem); max-width: 32ch; color: var(--chalk); }
  .lede strong { color: var(--accent); font-weight: 600; }
  .pillars {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* symmetric 2x2 */
    gap: 1.2rem;
    margin: 2rem 0;
  }
  @media (max-width: 620px) {
    .pillars { grid-template-columns: 1fr; }
  }
  .pillar { position: relative; display: flex; flex-direction: column; border-top: 3px solid var(--c); }
  .pillar .kicker {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--c);
    opacity: 0.85;
  }
  .pillar h2 { color: var(--c); font-size: clamp(1.7rem, 3.5vw, 2.1rem); margin: 0.1em 0 0.3em; }
  .pillar p { margin: 0 0 1rem; }
  .pillar .go {
    margin-top: auto;
    font-family: var(--font-label);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--chalk-faint);
  }
  .pillar:hover .go { color: var(--c); }
</style>
