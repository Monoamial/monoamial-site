---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('teaching', (e) => !e.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Teaching" description="Mentoring students as they develop long-term projects around their own interests.">
  <header class="page-head">
    <h1>Teaching</h1>
    <p>Most of my teaching takes the form of long-term mentorship: helping students turn their interests into sustained projects.</p>
  </header>
  <div class="list">
    {entries.length === 0 && <p class="empty">No entries yet.</p>}
    {entries.map((e) => (
      <EntryCard
        href={`/teaching/${e.id}/`}
        title={e.data.title}
        date={e.data.date}
        description={e.data.description}
        tags={e.data.tags}
        badges={[e.data.role, e.data.term].filter(Boolean)}
      />
    ))}
  </div>
</Base>
<style>
  .page-head { margin: 1.5rem 0 2rem; }
  .page-head h1 { color: var(--accent-4); }
  .list { display: grid; gap: 1.1rem; }
  .empty { color: var(--chalk-faint); font-style: italic; }
</style>
